# ---------------------------------------------------------------------------
# Bug Tracker - environment configuration
# Copy this file to ".env" and fill in real values. The app REFUSES TO START
# if any of the required values below are missing - there are no fallbacks.
# ---------------------------------------------------------------------------

# Connection string for your shared PostgreSQL server.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://bugtracker:CHANGE_ME@your-db-server:5432/bugtracker?schema=public"

# Shared team login. Everyone on the team uses this one password; each person
# types their own display name at login so bug "reporter" fields are meaningful.
AUTH_PASSWORD="CHANGE_ME_to_a_long_random_password"

# Secret used to sign the session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="CHANGE_ME_generate_a_32_byte_random_hex_string"

# Port the app listens on (optional, defaults to 3000).
# PORT=3000

# REQUIRED now that the app is hosted (Netlify) instead of bound to
# 127.0.0.1. This is the only thing protecting the MCP agent's endpoints:
# POST /api/bugs (log_bug), plus the read-only GET /api/bugs,
# GET /api/bugs/:id and GET /api/attachments/:id used by list_bugs/get_bug.
# The MCP server must send the exact same value as the `x-agent-token` header
# (put it in claude_desktop_config.json's env block, or the packaged .mcpb's
# "Agent Token" field) or its calls are rejected. There is no default value -
# the app refuses to start without this set. Generate one the same way as
# SESSION_SECRET above.
AGENT_TOKEN="CHANGE_ME_generate_another_random_hex_string"

# Only relevant when running locally (start.sh/start.bat, npm run dev) - the
# app binds to 127.0.0.1 so no other machine on your LAN can reach it. Not
# used when deployed to Netlify, which handles hosting/binding itself.
HOST=127.0.0.1
